# Copy to .env.local and fill in. Never put the Supabase service_role key here:
# everything prefixed NEXT_PUBLIC_ is sent to the browser.

# Supabase project URL and publishable (anon) key:
# Supabase dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Public base URL of the site (SEO links, sitemap, social previews)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: time zone used for dates in social preview images and search
# snippets, where the visitor's own time zone isn't known. Default: UTC
# SITE_TIME_ZONE=Pacific/Port_Moresby
